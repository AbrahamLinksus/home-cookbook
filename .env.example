# Home Cookbook settings (all optional; defaults shown). The app reads environment variables only, not a .env file: put a setting in front of the command, e.g. COOKBOOK_PORT=8800 uv run cookbook
COOKBOOK_HOST=0.0.0.0
COOKBOOK_PORT=8765
# COOKBOOK_DB defaults to $XDG_DATA_HOME/home-cookbook/cookbook.db (else ~/.local/share/home-cookbook/cookbook.db)
COOKBOOK_DB=
COOKBOOK_UNDO_SECONDS=10
